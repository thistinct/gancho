{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gancho",
  "version": "0.1.0",
  "identifier": "uy.gancho.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gancho",
        "width": 560,
        "height": 760,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Firmar PDFs con la cédula uruguaya",
    "linux": {
      "deb": {
        "depends": ["pcscd"]
      },
      "rpm": {
        "depends": ["pcsc-lite"]
      }
    }
  }
}
